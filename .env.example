# ============================================================
# وزارة الكشف الدولي — متغيرات البيئة
# ============================================================
# انسخ هذا الملف إلى .env (للعمل المحلي) وضع نفس القيم في:
# Vercel → Project Settings → Environment Variables
# ============================================================

# قاعدة البيانات PostgreSQL (مطلوبة للنشر)
# أنشئ قاعدة مجانية على Neon (neon.tech) أو Supabase (supabase.com)
# ثم الصق رابط الاتصال هنا — نفس الرابط تُضعه في Vercel
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# مفتاح Google Gemini API (اختياري)
# مطلوب فقط لتشغيل محرك الاستخبارات الاصطناعي والتوليد الموثق في صفحة الشبكة
# بدون المفتاح يعمل الموقع في "وضع الاحتياط" من قاعدة الرصد المحلية
GEMINI_API_KEY=AIza...